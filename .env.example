# Wallets. `bun run wallet` fills these in. Keep only faucet funds in them.
GATEWAY_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
SELLER_ADDRESS=

# Chain (defaults to the public GOAT Testnet3 RPC)
RPC_URL=

# Spending rules, in BTC
BUDGET_BTC=0.0001
AGENT_LIMIT_BTC=0.00002
MAX_PRICE_BTC=0.00001

# Approved sellers and the only address each may be paid at: origin=address, comma-separated
SELLERS=http://127.0.0.1:3001=0xYourSellerAddress

# Agents, as name=token pairs. An agent gets a token, never the wallet key.
AGENT_TOKENS=agent-1=change-me
ADMIN_TOKEN=change-me-too

# Mock seller
PRICE_BTC=0.000001
