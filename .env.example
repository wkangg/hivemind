# Wallets. The `wallet` script fills these in. Keep only faucet funds in them.
GATEWAY_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
# The address the seller is paid at. It must match the receiving address set in the
# GOAT Flow merchant portal, because the gateway refuses to pay anywhere else.
SELLER_ADDRESS=

# GOAT Flow merchant credentials, from https://flow-merchant.testnet3.goat.network
# (Developer > API Keys & Webhooks). Only the seller uses them.
GOATFLOW_API_KEY=
GOATFLOW_API_SECRET=

# Chain and token (default to GOAT Testnet3 and its test USDC)
RPC_URL=
TOKEN_ADDRESS=
TOKEN_SYMBOL=

# Spending rules, in USDC
BUDGET=5
AGENT_LIMIT=1
MAX_PRICE=0.5

# Approved sellers and the only address each may be paid at: origin=address, comma-separated
SELLERS=http://127.0.0.1:3001=0xYourSellerAddress

# Agents, as name=token pairs. An agent gets a token, never the wallet key.
AGENT_TOKENS=agent-1=change-me
ADMIN_TOKEN=change-me-too

# Mock seller's price, in USDC
PRICE=0.1
